#!/bin/bash

#  WorkflowName and ID:
#  Use ./ci_workflows.sh to get the WORKFLOW_ID and WORKFLOW_NAME settings below.

OWNER=vanelsberg
REPO=AndroidAPS
PERSONAL_ACCESS_TOKEN=$(cat ../secrets.yaml | grep aaps_ci_access_token_ha | cut -d ':' -f2 | xargs)
WORKFLOW_ID=257323460
WORKFLOW_NAME="Branch CI"

# Note on buildvariant:
#  default: "fullRelease"
#  options:
#    - fullRelease
#    - fullDebug
#    - aapsclientRelease
#    - aapsclientDebug
#    - aapsclient2Release
#    - aapsclient2Debug
#    - pumpcontrolRelease
#    - pumpcontrolDebug

OPT_BUILDVARIANT=fullRelease

# AAPS CI Branch to build
BRANCH="dev"
